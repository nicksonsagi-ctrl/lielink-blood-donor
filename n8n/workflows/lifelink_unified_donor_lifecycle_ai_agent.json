          }
        ],
        [
          {
            "node": "Is Response ACCEPTED?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini AI: Triage Request & Nearby Hospitals": {
      "main": [
        [
          {
            "node": "Send Email to Donor (With Nearby Hospitals)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Response ACCEPTED?": {
      "main": [
        [
          {
